# AI API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# Search APIs (Optional - for enhanced research)
SERPAPI_KEY=your_serpapi_key_here
BING_SEARCH_API_KEY=your_bing_search_key_here

# Content APIs (Optional)
UNSPLASH_ACCESS_KEY=your_unsplash_key_here
PEXELS_API_KEY=your_pexels_key_here

# Database (Optional - for storing research history)
DATABASE_URL=sqlite:///research.db

# Output Settings
DEFAULT_OUTPUT_DIR=outputs
MAX_RESEARCH_DEPTH=deep
DEFAULT_CONTENT_TYPE=blog

# Quality Control
FACT_CHECK_ENABLED=true
BIAS_DETECTION_ENABLED=true
MIN_SOURCES_REQUIRED=5

# Rate Limiting
API_RATE_LIMIT_RPM=60
RESEARCH_TIMEOUT_MINUTES=30