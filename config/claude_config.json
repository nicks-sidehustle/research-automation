        "source_analysis",
        "fact_checking",
        "synthesis",
        "report_generation"
      ],
      "quality_standards": {
        "min_sources": 5,
        "confidence_levels": true,
        "citation_required": true
      }
    },
    "content_formatter": {
      "enabled": true,
      "agent_file": "content-formatter.md",
      "capabilities": [
        "blog_generation",
        "podcast_scripting",
        "video_scripting",
        "ebook_formatting",
        "social_media_content"
      ],
      "optimization": {
        "seo_focused": true,
        "platform_specific": true,
        "engagement_optimized": true
      }
